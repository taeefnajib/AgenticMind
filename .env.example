# Copy to .env (never commit .env). The API loads .env from the directory it is started in
# (the repo root for `npm run dev:api`); real environment variables take precedence.

# Persistence: SQLite by default; PostgreSQL via psycopg (install the api's `postgres` extra).
AGENTICMIND_DATABASE_URL=sqlite:///./.agenticmind/agenticmind.db
# AGENTICMIND_DATABASE_URL=postgresql+psycopg://agenticmind:agenticmind@localhost:5432/agenticmind

# Comma-separated origins allowed to call the API directly (the Vite dev server proxies /api).
AGENTICMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Node trust levels allowed to execute in-process (core only by default; see docs/adr/0004, 0021).
# Third-party node packages are installed under "Node packages" and run in isolated workers instead;
# adding "community" here would also import non-core packages from this Python environment in-process.
AGENTICMIND_IN_PROCESS_TRUST=core

# Secrets referenced in the IR as {"$secret": "NAME"} resolve from env var {prefix}NAME.
AGENTICMIND_SECRET_PREFIX=
# Referenced from node configs as {"$secret": "OPENROUTER_API_KEY"} etc.
# OPENROUTER_API_KEY=...

# Native model providers (ADR-0036): add only the ones you use, then pick the provider in a node.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=        (node base_url = https://<resource>.openai.azure.com, model = deployment name)
# AWS_BEARER_TOKEN_BEDROCK=    (Bedrock API key; node base_url = the AWS region, e.g. us-east-1)
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# Claude refusal fallbacks (server-side, on supporting models): set 0 to turn off.
# AGENTICMIND_ANTHROPIC_FALLBACKS=1

# User-Agent for the agents' Web Fetch tool. Many sites (e.g. Wikipedia) require contact details:
# AGENTICMIND_HTTP_USER_AGENT=MyAgents/1.0 (https://example.org; you@example.org)
# PINECONE_API_KEY=...
# PGVECTOR_DSN=postgresql://user:password@localhost:5432/agenticmind

AGENTICMIND_MAX_CONCURRENCY=8

# AI workflow designer ("Build with AI" button, bottom right). Defaults: OpenRouter, Gemini, key from OPENROUTER_API_KEY.
# (defaults; admins can override provider and model in Settings → AI assistant)
# AGENTICMIND_ASSISTANT_PROVIDER=openrouter
# AGENTICMIND_ASSISTANT_MODEL=google/gemini-3.8-flash
# AGENTICMIND_ASSISTANT_API_KEY_SECRET=OPENROUTER_API_KEY

# Key that encrypts secrets saved in Settings → Secrets (32 bytes, URL-safe base64). If unset, one is generated
# into <data dir>/secret.key on first start: back that file up together with the database.
# AGENTICMIND_SECRET_KEY=

# Sign-in (ADR-0023, ADR-0032): "off" (default: single local user, no sign-in; keep the server on localhost)
# or "required" (accounts: the IDE asks you to create the admin account first; use it whenever other people
# or machines can reach the server). Set COOKIE_SECURE=1 behind HTTPS.
# AGENTICMIND_AUTH=off

# MCP server endpoint /api/mcp (ADR-0033): serves only projects marked "Expose as MCP tool".
# AGENTICMIND_MCP_SERVER=1
# Require this bearer token from MCP clients (recommended whenever the server is reachable by others):
# AGENTICMIND_MCP_TOKEN=
# Host headers accepted by /api/mcp (DNS-rebinding protection); host:* allows any port:
# AGENTICMIND_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
# AGENTICMIND_MCP_RUN_TIMEOUT=300

# Code execution (ADR-0034): "docker" (default; needs Docker running), "process" (trusted local code only:
# not a security boundary, network not blocked) or "off".
# AGENTICMIND_SANDBOX=docker
# AGENTICMIND_SANDBOX_ALLOW_NETWORK=0
# AGENTICMIND_SANDBOX_MAX_TIMEOUT=300
# AGENTICMIND_SANDBOX_MAX_MEMORY_MB=2048
# AGENTICMIND_SANDBOX_PYTHON_IMAGE=python:3.12-slim
# AGENTICMIND_SANDBOX_NODE_IMAGE=node:22-slim
# AGENTICMIND_SESSION_DAYS=14
# AGENTICMIND_COOKIE_SECURE=0

# Deployment Center: let AgenticMind run Docker to deploy projects on this machine (127.0.0.1 only).
# Off by default because building and running containers is a privilege; enable only on a trusted machine.
# AGENTICMIND_LOCAL_DEPLOY=1

# API keys for apps created with "Export app": clients send one of these in the X-API-Key header.
# Comma-separated; set the same line in the exported project's .env. (The AgenticMind server itself
# does not check API keys yet; keep it on localhost.)
# APP_API_KEYS=change-me-to-a-long-random-string
# Hugging Face Inference Providers (provider "huggingface"): a fine-grained token allowed to call Inference Providers.
# HF_TOKEN=...
# Ollama needs no key: run `ollama serve` and `ollama pull llava` (or another model).
# NVIDIA_API_KEY=...

# NVIDIA Auto Ontology (docs/architecture/auto-ontology.md). NVIDIA_API_KEY is what the Auto Ontology
# deployment uses for its models; AgenticMind itself only needs an API token for that deployment
# (Auto Ontology → user menu → API Tokens).
# AUTO_ONTOLOGY_API_KEY=...
