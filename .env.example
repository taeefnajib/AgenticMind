# Copy to .env (never commit .env). The API loads .env from the directory it is started in
# (the repo root for `npm run dev:api`); real environment variables take precedence.

# Persistence: SQLite by default; PostgreSQL via psycopg (install the api's `postgres` extra).
AGENTICMIND_DATABASE_URL=sqlite:///./.agenticmind/agenticmind.db
# AGENTICMIND_DATABASE_URL=postgresql+psycopg://agenticmind:agenticmind@localhost:5432/agenticmind

# Comma-separated origins allowed to call the API directly (the Vite dev server proxies /api).
AGENTICMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Node trust levels allowed to execute in-process (core only by default; see docs/adr/0004, 0021).
# Third-party node packages are installed under "Node packages" and run in isolated workers instead;
# adding "community" here would also import non-core packages from this Python environment in-process.
AGENTICMIND_IN_PROCESS_TRUST=core

# Secrets referenced in the IR as {"$secret": "NAME"} resolve from env var {prefix}NAME.
AGENTICMIND_SECRET_PREFIX=
# Referenced from node configs as {"$secret": "OPENROUTER_API_KEY"} etc.
# OPENROUTER_API_KEY=...

# User-Agent for the agents' Web Fetch tool. Many sites (e.g. Wikipedia) require contact details:
# AGENTICMIND_HTTP_USER_AGENT=MyAgents/1.0 (https://example.org; you@example.org)
# PINECONE_API_KEY=...
# PGVECTOR_DSN=postgresql://user:password@localhost:5432/agenticmind

AGENTICMIND_MAX_CONCURRENCY=8

# AI workflow designer (sparkle button on the canvas). Defaults: OpenRouter, Gemini, key from OPENROUTER_API_KEY.
# AGENTICMIND_ASSISTANT_PROVIDER=openrouter
# AGENTICMIND_ASSISTANT_MODEL=google/gemini-3.8-flash
# AGENTICMIND_ASSISTANT_API_KEY_SECRET=OPENROUTER_API_KEY

# Deployment Center: let AgenticMind run Docker to deploy projects on this machine (127.0.0.1 only).
# Off by default because the API has no authentication yet; enable only on a trusted machine.
# AGENTICMIND_LOCAL_DEPLOY=1

# API keys for apps created with "Export app": clients send one of these in the X-API-Key header.
# Comma-separated; set the same line in the exported project's .env. (The AgenticMind server itself
# does not check API keys yet; keep it on localhost.)
# APP_API_KEYS=change-me-to-a-long-random-string
# NVIDIA_API_KEY=...

# NVIDIA Auto Ontology (docs/architecture/auto-ontology.md). NVIDIA_API_KEY is what the Auto Ontology
# deployment uses for its models; AgenticMind itself only needs an API token for that deployment
# (Auto Ontology → user menu → API Tokens).
# AUTO_ONTOLOGY_API_KEY=...
