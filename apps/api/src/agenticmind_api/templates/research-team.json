{
 "ir_version": "1.0",
 "project": {
  "id": "template",
  "name": "Research team (supervisor + subagents)",
  "description": "A supervisor agent (Gemini via OpenRouter) delegates to two specialists: a researcher that may read Wikipedia and an analyst with a calculator and clock. Each handoff is a traced tool call with its own limits; the specialists' cost counts toward the supervisor's budget. Ask in the Chat tab, e.g. 'How many years passed between the first Moon landing and the founding of SpaceX?' Wikipedia only answers bots whose User-Agent includes contact details: set AGENTICMIND_HTTP_USER_AGENT in .env (see README)."
 },
 "runtime": {
  "engine": "agenticmind",
  "profile": "development"
 },
 "nodes": [
  {
   "id": "question",
   "type": "agenticmind.core.manual_input",
   "version": "1.0.0",
   "config": {
    "key": "question",
    "value_type": "String",
    "required": true,
    "default": null
   },
   "ui": {
    "position": {
     "x": 0,
     "y": 160
    },
    "label": "Question"
   }
  },
  {
   "id": "wiki",
   "type": "agenticmind.agents.tool_web_fetch",
   "version": "1.0.0",
   "config": {
    "name": "fetch_web_page",
    "allowed_domains": [
     "en.wikipedia.org"
    ],
    "max_chars": 8000,
    "timeout_seconds": 15,
    "description": "Fetch an English Wikipedia page (https://en.wikipedia.org/wiki/...) and return its text."
   },
   "ui": {
    "position": {
     "x": 0,
     "y": 330
    },
    "label": "Wikipedia"
   }
  },
  {
   "id": "calc",
   "type": "agenticmind.agents.tool_calculator",
   "version": "1.0.0",
   "config": {
    "name": "calculator"
   },
   "ui": {
    "position": {
     "x": 0,
     "y": 470
    }
   }
  },
  {
   "id": "clock",
   "type": "agenticmind.agents.tool_datetime",
   "version": "1.0.0",
   "config": {
    "name": "current_datetime"
   },
   "ui": {
    "position": {
     "x": 0,
     "y": 590
    }
   }
  },
  {
   "id": "researcher",
   "type": "agenticmind.agents.subagent",
   "version": "1.0.0",
   "config": {
    "name": "researcher",
    "provider": "openrouter",
    "model": "google/gemini-3.8-flash",
    "api_key": {
     "$secret": "OPENROUTER_API_KEY"
    },
    "description": "Looks up facts (names, dates, numbers) on Wikipedia. Give it one precise question; it returns the facts with the page it used.",
    "instructions": "You are a fact researcher. Use fetch_web_page on the most relevant English Wikipedia article. Return only the facts asked for, each with the article URL. If you cannot find it, say so.",
    "max_turns": 5,
    "max_tool_calls": 4,
    "token_budget": 40000,
    "cost_budget_usd": 0.1,
    "timeout_seconds": 120,
    "temperature": 0.1,
    "max_tokens": 1500,
    "on_limit": "return_partial"
   },
   "ui": {
    "position": {
     "x": 320,
     "y": 330
    },
    "label": "Researcher"
   }
  },
  {
   "id": "analyst",
   "type": "agenticmind.agents.subagent",
   "version": "1.0.0",
   "config": {
    "name": "analyst",
    "provider": "openrouter",
    "model": "google/gemini-3.8-flash",
    "api_key": {
     "$secret": "OPENROUTER_API_KEY"
    },
    "description": "Does arithmetic and date calculations exactly. Give it the numbers and what to compute.",
    "instructions": "You are a precise analyst. Always use the calculator for arithmetic and current_datetime for today's date. Show the calculation briefly.",
    "max_turns": 6,
    "max_tool_calls": 6,
    "token_budget": 20000,
    "cost_budget_usd": 0.05,
    "timeout_seconds": 60,
    "temperature": 0.0,
    "max_tokens": 1500,
    "on_limit": "return_partial"
   },
   "ui": {
    "position": {
     "x": 320,
     "y": 520
    },
    "label": "Analyst"
   }
  },
  {
   "id": "supervisor",
   "type": "agenticmind.agents.agent",
   "version": "1.1.0",
   "config": {
    "provider": "openrouter",
    "model": "google/gemini-3.8-flash",
    "api_key": {
     "$secret": "OPENROUTER_API_KEY"
    },
    "instructions": "You lead a small team. Delegate fact-finding to `researcher` and any calculation to `analyst`; give each one clear task plus the context it needs (e.g. pass the researcher's facts to the analyst). Check their answers for consistency, then write the final answer yourself and say which specialist provided what. If a specialist could not complete its task, say so plainly and mark anything you add from your own knowledge as unverified. Do not delegate trivial things.",
    "max_turns": 8,
    "max_tool_calls": 6,
    "token_budget": 120000,
    "cost_budget_usd": 0.5,
    "on_limit": "fail",
    "tool_timeout_seconds": 30,
    "temperature": 0.2,
    "max_tokens": 2000
   },
   "ui": {
    "position": {
     "x": 660,
     "y": 200
    },
    "label": "Supervisor"
   }
  },
  {
   "id": "answer",
   "type": "agenticmind.core.output",
   "version": "1.0.0",
   "config": {
    "key": "answer"
   },
   "ui": {
    "position": {
     "x": 980,
     "y": 200
    },
    "label": "Answer"
   }
  }
 ],
 "edges": [
  {
   "id": "e1",
   "kind": "data",
   "source": {
    "node": "wiki",
    "port": "tool"
   },
   "target": {
    "node": "researcher",
    "port": "tools"
   }
  },
  {
   "id": "e2",
   "kind": "data",
   "source": {
    "node": "calc",
    "port": "tool"
   },
   "target": {
    "node": "analyst",
    "port": "tools"
   }
  },
  {
   "id": "e3",
   "kind": "data",
   "source": {
    "node": "clock",
    "port": "tool"
   },
   "target": {
    "node": "analyst",
    "port": "tools"
   }
  },
  {
   "id": "e4",
   "kind": "data",
   "source": {
    "node": "researcher",
    "port": "tool"
   },
   "target": {
    "node": "supervisor",
    "port": "tools"
   }
  },
  {
   "id": "e5",
   "kind": "data",
   "source": {
    "node": "analyst",
    "port": "tool"
   },
   "target": {
    "node": "supervisor",
    "port": "tools"
   }
  },
  {
   "id": "e6",
   "kind": "data",
   "source": {
    "node": "question",
    "port": "value"
   },
   "target": {
    "node": "supervisor",
    "port": "task"
   }
  },
  {
   "id": "e7",
   "kind": "data",
   "source": {
    "node": "supervisor",
    "port": "result"
   },
   "target": {
    "node": "answer",
    "port": "value"
   }
  }
 ],
 "metadata": {}
}
