{
 "ir_version": "1.0",
 "project": {
  "id": "template",
  "name": "RAG answers with citations",
  "description": "Ask questions about your documents and get answers that cite their sources. 1) Upload files in 'Load documents' and choose 'Run → Index report'. 2) Ask in the Chat tab (or choose 'Run → Answer'). Uses OpenRouter (Gemini) via the OPENROUTER_API_KEY secret."
 },
 "runtime": {
  "engine": "agenticmind",
  "profile": "development"
 },
 "nodes": [
  {
   "id": "load",
   "type": "agenticmind.data.document_loader",
   "version": "1.0.0",
   "config": {
    "files": [],
    "split_pdf_pages": true,
    "csv_mode": "file",
    "skip_empty": true
   },
   "ui": {
    "position": {
     "x": 0,
     "y": 0
    },
    "label": "Load documents"
   }
  },
  {
   "id": "clean",
   "type": "agenticmind.data.document_cleaner",
   "version": "1.0.0",
   "config": {
    "normalize_unicode": true,
    "remove_control_chars": true,
    "dehyphenate": true,
    "collapse_whitespace": true,
    "drop_empty": true,
    "min_chars": 0
   },
   "ui": {
    "position": {
     "x": 290,
     "y": 0
    }
   }
  },
  {
   "id": "chunk",
   "type": "agenticmind.rag.chunker",
   "version": "1.0.0",
   "config": {
    "strategy": "markdown",
    "unit": "tokens",
    "chunk_size": 200,
    "chunk_overlap": 30
   },
   "ui": {
    "position": {
     "x": 580,
     "y": 0
    }
   }
  },
  {
   "id": "embedding",
   "type": "agenticmind.rag.embedding_model",
   "version": "1.0.0",
   "config": {
    "provider": "fastembed",
    "model": "BAAI/bge-small-en-v1.5",
    "batch_size": 32
   },
   "ui": {
    "position": {
     "x": 580,
     "y": 190
    }
   }
  },
  {
   "id": "store",
   "type": "agenticmind.rag.vector_store",
   "version": "1.0.0",
   "config": {
    "backend": "qdrant",
    "collection": "documents",
    "namespace_by_project": true,
    "distance": "cosine"
   },
   "ui": {
    "position": {
     "x": 580,
     "y": 310
    }
   }
  },
  {
   "id": "index",
   "type": "agenticmind.rag.index_documents",
   "version": "1.1.0",
   "config": {
    "skip_unchanged": true,
    "recreate": false,
    "upsert_batch_size": 128,
    "keyword_index": true
   },
   "ui": {
    "position": {
     "x": 900,
     "y": 40
    }
   }
  },
  {
   "id": "index_report",
   "type": "agenticmind.core.output",
   "version": "1.0.0",
   "config": {
    "key": "index_report"
   },
   "ui": {
    "position": {
     "x": 1200,
     "y": 40
    },
    "label": "Index report"
   }
  },
  {
   "id": "question",
   "type": "agenticmind.core.manual_input",
   "version": "1.0.0",
   "config": {
    "key": "question",
    "value_type": "String",
    "default": "How many days of annual leave do employees get?",
    "required": true
   },
   "ui": {
    "position": {
     "x": 580,
     "y": 450
    },
    "label": "Question"
   }
  },
  {
   "id": "retrieve",
   "type": "agenticmind.rag.retriever",
   "version": "1.0.0",
   "config": {
    "top_k": 5,
    "filters": {}
   },
   "ui": {
    "position": {
     "x": 900,
     "y": 330
    }
   }
  },
  {
   "id": "context",
   "type": "agenticmind.rag.context_builder",
   "version": "1.0.0",
   "config": {
    "token_budget": 2500,
    "order": "relevance",
    "deduplicate": true
   },
   "ui": {
    "position": {
     "x": 1200,
     "y": 330
    }
   }
  },
  {
   "id": "llm",
   "type": "agenticmind.models.llm",
   "version": "1.1.0",
   "config": {
    "provider": "openrouter",
    "model": "google/gemini-3.8-flash",
    "api_key": {
     "$secret": "OPENROUTER_API_KEY"
    },
    "system_prompt": "You are a precise assistant that answers only from the provided sources.",
    "temperature": 0.1,
    "max_tokens": 2000
   },
   "ui": {
    "position": {
     "x": 1500,
     "y": 330
    }
   }
  },
  {
   "id": "cite",
   "type": "agenticmind.rag.citation_builder",
   "version": "1.0.0",
   "config": {
    "require_citations": false,
    "remove_invalid": true
   },
   "ui": {
    "position": {
     "x": 1800,
     "y": 330
    }
   }
  },
  {
   "id": "answer",
   "type": "agenticmind.core.output",
   "version": "1.0.0",
   "config": {
    "key": "answer"
   },
   "ui": {
    "position": {
     "x": 2100,
     "y": 330
    },
    "label": "Answer"
   }
  }
 ],
 "edges": [
  {
   "id": "e01",
   "kind": "data",
   "source": {
    "node": "load",
    "port": "documents"
   },
   "target": {
    "node": "clean",
    "port": "documents"
   }
  },
  {
   "id": "e02",
   "kind": "data",
   "source": {
    "node": "clean",
    "port": "documents"
   },
   "target": {
    "node": "chunk",
    "port": "documents"
   }
  },
  {
   "id": "e03",
   "kind": "data",
   "source": {
    "node": "chunk",
    "port": "chunks"
   },
   "target": {
    "node": "index",
    "port": "documents"
   }
  },
  {
   "id": "e04",
   "kind": "data",
   "source": {
    "node": "embedding",
    "port": "model"
   },
   "target": {
    "node": "index",
    "port": "model"
   }
  },
  {
   "id": "e05",
   "kind": "data",
   "source": {
    "node": "store",
    "port": "store"
   },
   "target": {
    "node": "index",
    "port": "store"
   }
  },
  {
   "id": "e06",
   "kind": "data",
   "source": {
    "node": "index",
    "port": "report"
   },
   "target": {
    "node": "index_report",
    "port": "value"
   }
  },
  {
   "id": "e07",
   "kind": "data",
   "source": {
    "node": "question",
    "port": "value"
   },
   "target": {
    "node": "retrieve",
    "port": "query"
   }
  },
  {
   "id": "e08",
   "kind": "data",
   "source": {
    "node": "embedding",
    "port": "model"
   },
   "target": {
    "node": "retrieve",
    "port": "model"
   }
  },
  {
   "id": "e09",
   "kind": "data",
   "source": {
    "node": "store",
    "port": "store"
   },
   "target": {
    "node": "retrieve",
    "port": "store"
   }
  },
  {
   "id": "e10",
   "kind": "data",
   "source": {
    "node": "retrieve",
    "port": "documents"
   },
   "target": {
    "node": "context",
    "port": "documents"
   }
  },
  {
   "id": "e11",
   "kind": "data",
   "source": {
    "node": "question",
    "port": "value"
   },
   "target": {
    "node": "context",
    "port": "question"
   }
  },
  {
   "id": "e12",
   "kind": "data",
   "source": {
    "node": "context",
    "port": "prompt"
   },
   "target": {
    "node": "llm",
    "port": "prompt"
   }
  },
  {
   "id": "e13",
   "kind": "data",
   "source": {
    "node": "llm",
    "port": "text"
   },
   "target": {
    "node": "cite",
    "port": "answer"
   }
  },
  {
   "id": "e14",
   "kind": "data",
   "source": {
    "node": "context",
    "port": "sources"
   },
   "target": {
    "node": "cite",
    "port": "sources"
   }
  },
  {
   "id": "e15",
   "kind": "data",
   "source": {
    "node": "cite",
    "port": "result"
   },
   "target": {
    "node": "answer",
    "port": "value"
   }
  }
 ],
 "metadata": {}
}
