{
  "ir_version": "1.0",
  "project": {
    "id": "template",
    "name": "Ticket triage (loop + router + join)",
    "description": "For each support ticket, a Router picks billing / technical / default and the matching reply is written; Join gathers it and Loop End collects all replies. The Router uses rules (free, offline); set its mode to 'llm' to let Gemini classify instead (uses OPENROUTER_API_KEY)."
  },
  "runtime": {"engine": "agenticmind", "profile": "development"},
  "nodes": [
    {"id": "tickets", "type": "agenticmind.core.manual_input", "version": "1.0.0",
     "config": {"key": "tickets", "value_type": "JSON", "required": true,
                "default": ["I was charged twice on my last invoice.", "The app crashes when I try to log in.", "Do you have an office in Dhaka?", "Can I get a refund for my annual plan?"]},
     "ui": {"position": {"x": 0, "y": 200}, "label": "Tickets"}},
    {"id": "each", "type": "agenticmind.core.loop", "version": "1.0.0",
     "config": {"mode": "for_each", "item_type": "String", "state_type": "Any", "max_items": 100, "on_too_many": "fail", "concurrency": 2, "on_item_error": "fail", "max_iterations": 5},
     "ui": {"position": {"x": 290, "y": 200}, "label": "For each ticket"}},
    {"id": "route", "type": "agenticmind.core.router", "version": "1.0.0",
     "config": {"mode": "rules", "case_sensitive": false, "provider": "openrouter", "model": "google/gemini-3.8-flash",
                "api_key": {"$secret": "OPENROUTER_API_KEY"},
                "routes": [
                  {"name": "billing", "description": "Invoices, refunds, payments, charges", "operator": "regex", "value": "invoice|refund|charge|payment|billing"},
                  {"name": "technical", "description": "Bugs, errors, crashes, login or access problems", "operator": "regex", "value": "error|bug|crash|login|password|cannot|can't"}
                ]},
     "ui": {"position": {"x": 580, "y": 120}, "label": "Classify"}},
    {"id": "reply_billing", "type": "agenticmind.core.text_template", "version": "1.0.0",
     "config": {"template": "[billing] Thanks for reaching out about \"{{ text }}\". Our billing team will review your account within 1 business day.", "strict": true},
     "ui": {"position": {"x": 900, "y": 0}, "label": "Billing reply"}},
    {"id": "reply_technical", "type": "agenticmind.core.text_template", "version": "1.0.0",
     "config": {"template": "[technical] Sorry about \"{{ text }}\". A support engineer will contact you; meanwhile try updating the app.", "strict": true},
     "ui": {"position": {"x": 900, "y": 180}, "label": "Technical reply"}},
    {"id": "reply_general", "type": "agenticmind.core.text_template", "version": "1.0.0",
     "config": {"template": "[general] Thanks for your message: \"{{ text }}\". We will get back to you soon.", "strict": true},
     "ui": {"position": {"x": 900, "y": 360}, "label": "General reply"}},
    {"id": "join", "type": "agenticmind.core.join", "version": "1.0.0",
     "config": {"mode": "concat", "separator": "\n\n", "min_values": 1},
     "ui": {"position": {"x": 1210, "y": 200}}},
    {"id": "each_end", "type": "agenticmind.core.loop_end", "version": "1.0.0",
     "config": {},
     "ui": {"position": {"x": 1490, "y": 200}, "label": "Collect replies"}},
    {"id": "replies", "type": "agenticmind.core.output", "version": "1.0.0",
     "config": {"key": "replies"},
     "ui": {"position": {"x": 1780, "y": 140}, "label": "Replies"}},
    {"id": "loop_report", "type": "agenticmind.core.output", "version": "1.0.0",
     "config": {"key": "loop_report"},
     "ui": {"position": {"x": 1780, "y": 300}, "label": "Loop report"}}
  ],
  "edges": [
    {"id": "e01", "kind": "data", "source": {"node": "tickets", "port": "value"}, "target": {"node": "each", "port": "items"}},
    {"id": "e02", "kind": "data", "source": {"node": "each", "port": "scope"}, "target": {"node": "each_end", "port": "scope"}},
    {"id": "e03", "kind": "data", "source": {"node": "each", "port": "item"}, "target": {"node": "route", "port": "value"}},
    {"id": "c01", "kind": "control", "source": {"node": "route", "port": "billing"}, "target": {"node": "reply_billing", "port": "trigger"}},
    {"id": "c02", "kind": "control", "source": {"node": "route", "port": "technical"}, "target": {"node": "reply_technical", "port": "trigger"}},
    {"id": "c03", "kind": "control", "source": {"node": "route", "port": "default"}, "target": {"node": "reply_general", "port": "trigger"}},
    {"id": "e04", "kind": "data", "source": {"node": "each", "port": "item"}, "target": {"node": "reply_billing", "port": "text"}},
    {"id": "e05", "kind": "data", "source": {"node": "each", "port": "item"}, "target": {"node": "reply_technical", "port": "text"}},
    {"id": "e06", "kind": "data", "source": {"node": "each", "port": "item"}, "target": {"node": "reply_general", "port": "text"}},
    {"id": "e07", "kind": "data", "source": {"node": "reply_billing", "port": "text"}, "target": {"node": "join", "port": "values"}},
    {"id": "e08", "kind": "data", "source": {"node": "reply_technical", "port": "text"}, "target": {"node": "join", "port": "values"}},
    {"id": "e09", "kind": "data", "source": {"node": "reply_general", "port": "text"}, "target": {"node": "join", "port": "values"}},
    {"id": "e10", "kind": "data", "source": {"node": "join", "port": "value"}, "target": {"node": "each_end", "port": "value"}},
    {"id": "e11", "kind": "data", "source": {"node": "each_end", "port": "results"}, "target": {"node": "replies", "port": "value"}},
    {"id": "e12", "kind": "data", "source": {"node": "each_end", "port": "report"}, "target": {"node": "loop_report", "port": "value"}}
  ],
  "metadata": {}
}
