{
  "ir_version": "1.0",
  "project": {
    "id": "template",
    "name": "Assistant with memory",
    "description": "A chat assistant (Gemini via OpenRouter) that remembers the conversation and, only if you allow it, facts you share for future chats. Ask in the Chat tab; turn on 'Remember facts I share' to let it save memories. See and delete everything in the Memory tab."
  },
  "runtime": {"engine": "agenticmind", "profile": "development"},
  "nodes": [
    {"id": "question", "type": "agenticmind.core.manual_input", "version": "1.0.0",
     "config": {"key": "question", "value_type": "String", "required": true, "default": null},
     "ui": {"position": {"x": 0, "y": 0}, "label": "Question"}},
    {"id": "conversation", "type": "agenticmind.core.manual_input", "version": "1.0.0",
     "config": {"key": "conversation_id", "value_type": "String", "required": false, "default": "default"},
     "ui": {"position": {"x": 0, "y": 170}, "label": "Conversation ID"}},
    {"id": "consent", "type": "agenticmind.core.manual_input", "version": "1.0.0",
     "config": {"key": "memory_consent", "value_type": "Boolean", "required": false, "default": false},
     "ui": {"position": {"x": 0, "y": 340}, "label": "Memory consent"}},
    {"id": "history", "type": "agenticmind.agents.conversation_history", "version": "1.0.0",
     "config": {"max_turns": 10, "max_chars": 8000},
     "ui": {"position": {"x": 300, "y": 120}}},
    {"id": "recall_tool", "type": "agenticmind.agents.tool_memory", "version": "1.0.0",
     "config": {"mode": "recall", "name": "recall_memory", "namespace": "default", "top_k": 5, "retention_days": 365,
                "description": "Search long-term memory for facts the user shared in earlier conversations (preferences, names, details). Use it before saying you don't know something about the user."},
     "ui": {"position": {"x": 300, "y": 300}, "label": "Recall memory"}},
    {"id": "save_tool", "type": "agenticmind.agents.tool_memory", "version": "1.0.0",
     "config": {"mode": "save", "name": "save_memory", "namespace": "default", "top_k": 5, "retention_days": 365,
                "description": "Store one short fact the user explicitly wants remembered for future conversations (e.g. a preference). Write it as a standalone sentence. Never store secrets, passwords or payment details."},
     "ui": {"position": {"x": 300, "y": 450}, "label": "Save memory"}},
    {"id": "agent", "type": "agenticmind.agents.agent", "version": "1.1.0",
     "config": {"provider": "openrouter", "model": "google/gemini-3.8-flash", "api_key": {"$secret": "OPENROUTER_API_KEY"},
                "instructions": "You are a friendly, concise assistant. You see the recent conversation. You also have long-term memory tools: call recall_memory when the user asks about themselves or about something from an earlier chat. Call save_memory only when the user shares a lasting personal fact or preference, or asks you to remember something. If saving fails because memory is turned off, tell the user they can enable 'Remember facts I share'. Never claim you saved something unless save_memory succeeded.",
                "max_turns": 6, "max_tool_calls": 8, "token_budget": 60000, "cost_budget_usd": 0.25, "on_limit": "fail",
                "tool_timeout_seconds": 30, "temperature": 0.3, "max_tokens": 1000},
     "ui": {"position": {"x": 640, "y": 140}}},
    {"id": "save_turn", "type": "agenticmind.agents.save_turn", "version": "1.0.0",
     "config": {"retention_days": 30},
     "ui": {"position": {"x": 960, "y": 300}, "label": "Save turn"}},
    {"id": "answer", "type": "agenticmind.core.output", "version": "1.0.0",
     "config": {"key": "answer"},
     "ui": {"position": {"x": 1260, "y": 140}, "label": "Answer"}}
  ],
  "edges": [
    {"id": "e01", "kind": "data", "source": {"node": "conversation", "port": "value"}, "target": {"node": "history", "port": "conversation_id"}},
    {"id": "e02", "kind": "data", "source": {"node": "consent", "port": "value"}, "target": {"node": "save_tool", "port": "consent"}},
    {"id": "e03", "kind": "data", "source": {"node": "question", "port": "value"}, "target": {"node": "agent", "port": "task"}},
    {"id": "e04", "kind": "data", "source": {"node": "history", "port": "messages"}, "target": {"node": "agent", "port": "history"}},
    {"id": "e05", "kind": "data", "source": {"node": "recall_tool", "port": "tool"}, "target": {"node": "agent", "port": "tools"}},
    {"id": "e06", "kind": "data", "source": {"node": "save_tool", "port": "tool"}, "target": {"node": "agent", "port": "tools"}},
    {"id": "e07", "kind": "data", "source": {"node": "conversation", "port": "value"}, "target": {"node": "save_turn", "port": "conversation_id"}},
    {"id": "e08", "kind": "data", "source": {"node": "question", "port": "value"}, "target": {"node": "save_turn", "port": "user"}},
    {"id": "e09", "kind": "data", "source": {"node": "agent", "port": "answer"}, "target": {"node": "save_turn", "port": "assistant"}},
    {"id": "e10", "kind": "data", "source": {"node": "agent", "port": "result"}, "target": {"node": "answer", "port": "value"}},
    {"id": "c01", "kind": "control", "source": {"node": "save_turn", "port": "done"}, "target": {"node": "answer", "port": "trigger"}}
  ],
  "metadata": {}
}
