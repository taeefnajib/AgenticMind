{
  "ir_version": "1.0",
  "project": {
    "id": "template",
    "name": "Agent with tools",
    "description": "An agent (Gemini via OpenRouter) that decides when to search your documents, calculate or check the date. 1) Upload files in 'Load documents' and choose 'Run → Index report'. 2) Ask in the Chat tab, e.g. 'How many leave days do 3 employees get in total?'. Limits: 6 turns, 12 tool calls, $0.25 per question."
  },
  "runtime": {"engine": "agenticmind", "profile": "development"},
  "nodes": [
    {"id": "load", "type": "agenticmind.data.document_loader", "version": "1.0.0",
     "config": {"files": [], "split_pdf_pages": true, "csv_mode": "file", "skip_empty": true},
     "ui": {"position": {"x": 0, "y": 0}, "label": "Load documents"}},
    {"id": "chunk", "type": "agenticmind.rag.chunker", "version": "1.0.0",
     "config": {"strategy": "markdown", "unit": "tokens", "chunk_size": 200, "chunk_overlap": 30},
     "ui": {"position": {"x": 290, "y": 0}}},
    {"id": "embedding", "type": "agenticmind.rag.embedding_model", "version": "1.0.0",
     "config": {"provider": "fastembed", "model": "BAAI/bge-small-en-v1.5", "batch_size": 32},
     "ui": {"position": {"x": 290, "y": 190}}},
    {"id": "store", "type": "agenticmind.rag.vector_store", "version": "1.0.0",
     "config": {"backend": "qdrant", "collection": "documents", "namespace_by_project": true, "distance": "cosine"},
     "ui": {"position": {"x": 290, "y": 310}}},
    {"id": "index", "type": "agenticmind.rag.index_documents", "version": "1.0.0",
     "config": {"skip_unchanged": true, "recreate": false, "upsert_batch_size": 128},
     "ui": {"position": {"x": 610, "y": 40}}},
    {"id": "index_report", "type": "agenticmind.core.output", "version": "1.0.0",
     "config": {"key": "index_report"},
     "ui": {"position": {"x": 910, "y": 40}, "label": "Index report"}},
    {"id": "search", "type": "agenticmind.agents.tool_knowledge_search", "version": "1.0.0",
     "config": {"name": "search_documents", "top_k": 5,
                "description": "Search the indexed documents for passages relevant to a query. Use it for any question about the documents' content. Returns numbered passages with their source file, page and section."},
     "ui": {"position": {"x": 610, "y": 260}}},
    {"id": "calculator", "type": "agenticmind.agents.tool_calculator", "version": "1.0.0",
     "config": {"name": "calculator"},
     "ui": {"position": {"x": 610, "y": 400}}},
    {"id": "clock", "type": "agenticmind.agents.tool_datetime", "version": "1.0.0",
     "config": {"name": "current_datetime"},
     "ui": {"position": {"x": 610, "y": 500}}},
    {"id": "question", "type": "agenticmind.core.manual_input", "version": "1.0.0",
     "config": {"key": "question", "value_type": "String", "default": "How many days of annual leave do 3 full-time employees get in total?", "required": true},
     "ui": {"position": {"x": 610, "y": 610}, "label": "Question"}},
    {"id": "agent", "type": "agenticmind.agents.agent", "version": "1.0.0",
     "config": {"provider": "openrouter", "model": "google/gemini-3.8-flash", "api_key": {"$secret": "OPENROUTER_API_KEY"},
                "max_turns": 6, "max_tool_calls": 12, "token_budget": 60000, "cost_budget_usd": 0.25, "on_limit": "fail",
                "tool_timeout_seconds": 30, "temperature": 0.2, "max_tokens": 1500},
     "ui": {"position": {"x": 930, "y": 380}}},
    {"id": "answer", "type": "agenticmind.core.output", "version": "1.0.0",
     "config": {"key": "answer"},
     "ui": {"position": {"x": 1240, "y": 380}, "label": "Answer"}}
  ],
  "edges": [
    {"id": "e01", "kind": "data", "source": {"node": "load", "port": "documents"}, "target": {"node": "chunk", "port": "documents"}},
    {"id": "e02", "kind": "data", "source": {"node": "chunk", "port": "chunks"}, "target": {"node": "index", "port": "documents"}},
    {"id": "e03", "kind": "data", "source": {"node": "embedding", "port": "model"}, "target": {"node": "index", "port": "model"}},
    {"id": "e04", "kind": "data", "source": {"node": "store", "port": "store"}, "target": {"node": "index", "port": "store"}},
    {"id": "e05", "kind": "data", "source": {"node": "index", "port": "report"}, "target": {"node": "index_report", "port": "value"}},
    {"id": "e06", "kind": "data", "source": {"node": "embedding", "port": "model"}, "target": {"node": "search", "port": "model"}},
    {"id": "e07", "kind": "data", "source": {"node": "store", "port": "store"}, "target": {"node": "search", "port": "store"}},
    {"id": "e08", "kind": "data", "source": {"node": "search", "port": "tool"}, "target": {"node": "agent", "port": "tools"}},
    {"id": "e09", "kind": "data", "source": {"node": "calculator", "port": "tool"}, "target": {"node": "agent", "port": "tools"}},
    {"id": "e10", "kind": "data", "source": {"node": "clock", "port": "tool"}, "target": {"node": "agent", "port": "tools"}},
    {"id": "e11", "kind": "data", "source": {"node": "question", "port": "value"}, "target": {"node": "agent", "port": "task"}},
    {"id": "e12", "kind": "data", "source": {"node": "agent", "port": "result"}, "target": {"node": "answer", "port": "value"}}
  ],
  "metadata": {}
}
