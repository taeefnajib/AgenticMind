 "info": {
  "description": "Public HTTP surface of Auto Ontology, served by the Next.js route handlers. Generated by `pnpm openapi` \u2014 do not edit by hand.",
  "title": "Auto Ontology API",
  "version": "1.3.0",
  "x-agenticmind-source": {
   "commit": "778ccdef75536bee5653306f8ded655924e4ada8",
   "repo": "NVIDIA/auto-ontology"
  }
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/chat/completions": {
   "post": {
    "description": "Ask a question and stream the answer back as Server-Sent Events.\n\nFastAPI emits the SQL plus the formatted answer first (`result`), then \u2014\nwhen that answer has an executed result \u2014 generates and persists the\nchart/table bubble itself and streams it back as its own `charts` event\nbefore the stream closes. No second request needed from this route or the\nbrowser. Passing `conversation_id` persists the turn and additionally\nrequires `conversation: ['write']`; the route answers 409 while that\nconversation already has a run in flight. Omitting it runs the question\nstatelessly, with no history and no chart step.",
    "operationId": "post_api_chat_completions",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "properties": {
         "conversation_id": {
          "anyOf": [
           {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "evidence": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "prediction": {
          "anyOf": [
           {
            "type": "boolean"
           },
           {
            "type": "null"
           }
          ]
         },
         "question": {
          "minLength": 1,
          "type": "string"
         },
         "target_db": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "question"
        ],
        "type": "object"
       }
      }
     },
     "description": "SQL plus a formatted answer, streamed as SSE. When the answer has an executed result, the backend also generates and persists a chart (or fallback table) and streams it back on this same connection as its own `charts` event \u2014 no follow-up call needed. Reuse one `conversation_id` for follow-up turns; an unknown UUID creates a conversation, while an ID owned by another user returns 404. Omitting `conversation_id` runs the question statelessly, with no history and no chart step.",
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string"
        }
       }
      },
      "description": "Server-sent events; the stream ends with `data: [DONE]`"
     },
     "401": {
      "description": "No authenticated caller could be resolved"
     },
     "403": {
      "description": "The caller lacks the required permission"
     },
     "409": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": false,
         "properties": {
          "detail": {
           "type": "string"
          }
         },
         "required": [
          "detail"
         ],
         "type": "object"
        }
       }
      },
      "description": "Relayed from the backend: a run is already in flight for this conversation, or the semantic layer has not been compiled yet."
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "security": [
     {
      "ApiToken": []
     }
    ],
    "summary": "Ask a question and stream the answer back as Server-Sent Events.",
    "tags": [
     "chat"
    ],
    "x-auto-ontology-permissions": {
     "chat": [
      "use"
     ]
    },
    "x-auto-ontology-proxied": false,
    "x-auto-ontology-source": "frontend/app/api/chat/completions/route.ts",
    "x-auto-ontology-upstream": "/api/chat/completions"
   }
  },
  "/api/health": {
   "get": {
    "description": "Liveness/readiness probe for the Next.js tier, unauthenticated by design.\n\nProbes Postgres and answers 200 `{ status: 'ok' }`, or 503\n`{ status: 'degraded' }` carrying the failing check's error detail.",
    "operationId": "get_api_health",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": false,
         "properties": {
          "postgres": {
           "anyOf": [
            {
             "additionalProperties": false,
             "properties": {
              "status": {
               "const": "ok",
               "type": "string"
              }
             },
             "required": [
              "status"
             ],
             "type": "object"
            },
            {
             "additionalProperties": false,
             "description": "`detail` is the driver error, truncated to 200 characters.",
             "properties": {
              "detail": {
               "type": "string"
              },
